# Domínio raiz. Local: localhost:3000 | Produção: agenn.com.br
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Domínios antigos que redirecionam (301) para o atual, separados por vírgula
LEGACY_DOMAINS=
# Supabase (local: copie de `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile (vazio = desligado, padrão local)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Login com Google (true/false)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Sentry (vazio = desligado)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Mailpit do Supabase local (testes e2e)
MAILPIT_URL=http://127.0.0.1:54324
# Mídia: bunny (produção) ou fake (CI/local, grava no disco)
MEDIA_STORAGE_DRIVER=fake
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOST=br.storage.bunnycdn.com
# URL pública das imagens. Produção: Pull Zone do Bunny. Fake: /api/dev-media
NEXT_PUBLIC_MEDIA_BASE_URL=/api/dev-media
# Sal do hash de IP no limite de pedidos (mínimo 16 caracteres)
RATE_LIMIT_SALT=
# Pedidos por hora por IP (padrão 20)
ORDER_RATE_LIMIT_PER_HOUR=20
