# Ambiente. Na Netlify: production (só no contexto de produção). Vazio local e em prévias.
APP_ENV=
# Domínio raiz. Local: localhost:3000 | Produção: vitrimove.site
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Domínios antigos que redirecionam (301) para o atual, separados por vírgula
LEGACY_DOMAINS=
# Supabase (local: copie de `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile (vazio = desligado, padrão local)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Login com Google (true/false)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Sentry (vazio = desligado)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Mailpit do Supabase local (testes e2e)
MAILPIT_URL=http://127.0.0.1:54324
# Mídia: supabase (produção, bucket público "media") ou fake (CI/local, grava no disco)
MEDIA_STORAGE_DRIVER=fake
# URL pública das imagens. Produção: <SUPABASE_URL>/storage/v1/object/public/media. Fake: /api/dev-media
NEXT_PUBLIC_MEDIA_BASE_URL=/api/dev-media
# Sal do hash de IP no limite de pedidos (mínimo 16 caracteres)
RATE_LIMIT_SALT=
# Pedidos por hora por IP (padrão 20)
ORDER_RATE_LIMIT_PER_HOUR=20
# Vídeos: mux (produção) ou fake (CI/local)
VIDEO_DRIVER=fake
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing secret do endpoint de webhook do Mux
MUX_WEBHOOK_SECRET=
# Reprodução HLS. Produção: https://stream.mux.com. Fake: /api/dev-video
NEXT_PUBLIC_VIDEO_CDN_BASE_URL=/api/dev-video
# Segredo da tarefa diária /api/cron/diaria (mínimo 16 caracteres)
CRON_SECRET=
# Cadastro automático dos subdomínios das vitrines na Netlify (vazio = desligado)
NETLIFY_API_TOKEN=
NETLIFY_SITE_ID=
# E-mails do sistema: off (padrão), fake (CI/local, grava em disco) ou resend
EMAIL_DRIVER=off
RESEND_API_KEY=
EMAIL_FROM=Vitrimove <nao-responda@vitrimove.site>
# Cobrança: stripe (produção) ou fake (CI/local, checkout e portal simulados)
BILLING_DRIVER=fake
STRIPE_SECRET_KEY=
# Segredo de assinatura do endpoint de webhook (whsec_...); obrigatório nos dois drivers
STRIPE_WEBHOOK_SECRET=whsec-local-somente-para-testes
# Id do preço mensal do Plano Essencial no Stripe (price_..., R$ 29,90/mês)
STRIPE_PRICE_MONTH=
